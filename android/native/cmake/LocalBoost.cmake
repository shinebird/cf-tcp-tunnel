# Use modular Git checkouts without b2 headers, symlinks or writing in the repository.
function(cf_local_boost source)
    if(EXISTS "${source}/boost/version.hpp" AND EXISTS "${source}/boost/asio.hpp")
        set(includes "${source}")
        set(version_header "${source}/boost/version.hpp")
    else()
        file(GLOB includes CONFIGURE_DEPENDS LIST_DIRECTORIES TRUE "${source}/libs/*/include" "${source}/libs/numeric/*/include")
        set(version_header "${source}/libs/config/include/boost/version.hpp")
    endif()
    if(NOT EXISTS "${version_header}")
        message(FATAL_ERROR "Invalid local Boost tree. Initialize its submodules first.")
    endif()
    file(STRINGS "${version_header}" version_line REGEX "^#define BOOST_VERSION [0-9]+$")
    string(REGEX REPLACE ".*BOOST_VERSION ([0-9]+).*" "\\1" version "${version_line}")
    if(NOT version MATCHES "^[0-9]+$" OR version LESS 108300)
        message(FATAL_ERROR "Local Boost >=1.83 required")
    endif()
    foreach(header asio.hpp beast.hpp json.hpp json/src.hpp config.hpp)
        set(found FALSE)
        foreach(dir IN LISTS includes)
            if(EXISTS "${dir}/boost/${header}")
                set(found TRUE)
            endif()
        endforeach()
        if(NOT found)
            message(FATAL_ERROR "Missing local boost/${header}; git submodule update --init --recursive")
        endif()
    endforeach()
    add_library(cf_boost_headers INTERFACE)
    target_include_directories(cf_boost_headers SYSTEM INTERFACE ${includes})
    # Newer JSON uses compiled Charconv. Use the local library's own source list
    # so changes to Charconv's translation units are handled by its CMake recipe.
    set(json_uses_charconv FALSE)
    foreach(dir IN LISTS includes)
        file(GLOB_RECURSE json_headers CONFIGURE_DEPENDS
            "${dir}/boost/json/*.hpp" "${dir}/boost/json/*.ipp")
        foreach(header IN LISTS json_headers)
            file(STRINGS "${header}" charconv_includes REGEX "#[ \t]*include[ \t]*[<\"]boost/charconv")
            if(charconv_includes)
                set(json_uses_charconv TRUE)
                break()
            endif()
        endforeach()
        if(json_uses_charconv)
            break()
        endif()
    endforeach()
    if(json_uses_charconv)
        if(NOT EXISTS "${source}/libs/charconv/CMakeLists.txt" OR
           NOT EXISTS "${source}/libs/charconv/src/to_chars.cpp")
            message(FATAL_ERROR "This local Boost.JSON requires Boost.Charconv sources. Initialize the libs/charconv submodule in ${source}; headers alone are insufficient.")
        endif()
        # Charconv's dependencies are header-only and already covered by the
        # local include tree. Never find or link a prebuilt desktop Boost library.
        foreach(component config assert core)
            if(NOT TARGET Boost::${component})
                add_library(Boost::${component} ALIAS cf_boost_headers)
            endif()
        endforeach()
        set(BUILD_SHARED_LIBS OFF)
        set(BUILD_TESTING OFF)
        set(BOOST_CHARCONV_NO_QUADMATH ON)
        math(EXPR boost_major "${version} / 100000")
        math(EXPR boost_minor "(${version} / 100) % 1000")
        math(EXPR boost_patch "${version} % 100")
        set(BOOST_SUPERPROJECT_VERSION "${boost_major}.${boost_minor}.${boost_patch}")
        add_subdirectory("${source}/libs/charconv" "${CMAKE_CURRENT_BINARY_DIR}/local-charconv" EXCLUDE_FROM_ALL)
        set_target_properties(boost_charconv PROPERTIES POSITION_INDEPENDENT_CODE ON)
    endif()
    # Compile Boost.JSON with the SAME NDK, ABI, STL and PIC settings as the app.
    add_library(cf_json_local STATIC "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/boost_json_host.cpp")
    target_link_libraries(cf_json_local PUBLIC cf_boost_headers)
    if(json_uses_charconv)
        target_link_libraries(cf_json_local PUBLIC Boost::charconv)
    endif()
    set_target_properties(cf_json_local PROPERTIES POSITION_INDEPENDENT_CODE ON)
    message(STATUS "Local Boost ${version}: ${source}")
endfunction()
