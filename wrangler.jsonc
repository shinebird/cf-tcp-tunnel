{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tcp-tunnel",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "TunnelHub"
      }
    ]
  },
  "exports": {
    "TunnelHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },
  "vars": {
    "ALLOWED_PORTS": "22,3389,8080,8081,8083"
  }
}