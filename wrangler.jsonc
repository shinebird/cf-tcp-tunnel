{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tcp-tunnel",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "TunnelHub" }]
  },
  "exports": {
    "TunnelHub": { "type": "durable-object", "storage": "sqlite" }
  }
}
